# ContentPilot Configuration Example

# Database
POSTGRES_DB=contentpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=replace-with-a-secure-random-32-char-secret-key-12345
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Providers Configuration
DEMO_MODE_ENABLED=false
AI_TEXT_PROVIDER=gemini # gemini | claude | ollama | fallback
AI_TEXT_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
CLAUDE_API_KEY=your-anthropic-claude-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Creative Studio Image & Video Providers
AI_IMAGE_PROVIDER=fallback # comfyui | openai | fallback
COMFYUI_BASE_URL=http://comfyui:8188
OPENAI_API_KEY=your-openai-api-key
AI_VIDEO_PROVIDER=ffmpeg-motion
CREATIVE_STORAGE_DIR=./uploads/creative

# Integrations
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Frontend
FRONTEND_PORT=3000
